{
  "name": "clearchoice-ai",
  "version": "1.0.0",
  "description": "ClearChoice AI — AI-Powered Dark Pattern Detection Browser Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:panel": "vite",
    "build:extension": "vite build && vite build --config vite.config.content.ts",
    "build": "npm run build:extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite --config vite.config.demo.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "server": "tsx backend/src/server.ts",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.280",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
